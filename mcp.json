{
  "$schema": "https://mcp.so/schema.json",
  "name": "acornonaut",
  "display_name": "Acornonaut MCP Server",
  "description": "AI-powered flashcard generation from YouTube videos with spaced repetition scheduling. Features SM-2 algorithm, Anki export, and full playlist management.",
  "version": "2.5.4",
  "transport": {
    "type": "http",
    "url": "https://mcp.acornonaut.app"
  },
  "authentication": {
    "type": "oauth2",
    "authorization_url": "https://mcp.acornonaut.app/oauth/authorize",
    "token_url": "https://mcp.acornonaut.app/oauth/token"
  },
  "links": {
    "homepage": "https://acornonaut.app",
    "documentation": "https://acornonaut.app/docs/mcp",
    "repository": "https://github.com/zerolve-io/coursecards"
  },
  "categories": ["education", "productivity", "learning"],
  "tools": [
    "list_playlists",
    "get_playlist",
    "create_playlist",
    "update_playlist",
    "delete_playlist",
    "add_video_by_url",
    "get_video_cards",
    "get_transcript",
    "list_cards",
    "get_card",
    "create_card",
    "update_card",
    "delete_card",
    "search_cards",
    "review_due_cards",
    "answer_card",
    "get_review_stats",
    "export_deck"
  ]
}
