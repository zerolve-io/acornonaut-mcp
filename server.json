{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zerolve-io/acornonaut",
  "title": "Acornonaut MCP Server",
  "description": "AI-powered YouTube to flashcards with spaced repetition and Anki export",
  "version": "2.5.5",
  "homepage": "https://acornonaut.app",
  "documentation": "https://acornonaut.app/docs/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerolve-io/acornonaut-mcp",
    "source": "github"
  },
  "categories": ["education", "productivity", "learning"],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.acornonaut.app",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token for authentication (get your OAuth token at https://acornonaut.app/oauth/authorize)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "author": {
    "name": "Zerolve",
    "url": "https://zerolve.io"
  },
  "license": "MIT"
}
